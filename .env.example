# Copy to .env and fill in. .env is gitignored — never commit real values.
# In AWS these come from Secrets Manager via the ECS task definition, not from
# a file. See infra/modules/app/main.tf.

# --- Core -------------------------------------------------------------------
# Local dev via Homebrew Postgres: postgres://<you>@localhost:5432/nates_website
# Local dev via docker compose:    postgres://postgres:postgres@localhost:5433/nates_website
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nates_website

# Signing key for Payload sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-32-chars-minimum

# Public origin, used for canonical URLs, sitemap, and JSON-LD.
# Only set this for local development. In AWS, Terraform passes it to the
# container from the `domain_name` variable, and when no domain is configured
# the app derives its origin from the request instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: cap the Postgres connection pool (defaults to 10).
PGPOOL_MAX=

# --- Business & owner identity ----------------------------------------------
# These are the CMS's initial values, read by the seed script, and a fallback
# before anything is seeded. Real names, emails and phone numbers are kept out
# of git deliberately — after seeding, the CMS at /admin is the source of truth
# and the client edits them there without a redeploy.
#
# Leave them unset and the seed produces obviously-fictional placeholder data,
# which is what belongs in a shared repository.
BUSINESS_NAME="Example Benefits"
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=

# The practice owner, seeded as the team member.
# For a one-person practice leave OWNER_EMAIL and OWNER_PHONE unset — they
# fall back to BUSINESS_EMAIL and BUSINESS_PHONE.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=

# --- Media ------------------------------------------------------------------
# Leave S3_BUCKET empty locally: Payload falls back to disk storage, so no AWS
# credentials are needed to run the site.
S3_BUCKET=
AWS_REGION=us-east-1
# CloudFront host serving uploads; added to next/image remotePatterns.
NEXT_PUBLIC_MEDIA_HOST=

# --- Lead delivery to MedicarePRO CRM ---------------------------------------
# Transport: "mock" (stores and queues, delivers nowhere) | "webhook" | "zapier"
# Leads are always written to Postgres first, so an unset transport delays
# delivery but never loses a lead.
CRM_TRANSPORT=mock

# Preferred. Generated in MedicarePRO under Settings > Integrations. The URL is
# displayed exactly ONCE and cannot be retrieved again — save it straight into
# a password manager and Secrets Manager.
MEDICAREPRO_WEBHOOK_URL=

# Fallback. A Zapier catch-hook URL whose Zap runs the MPCRM "Add Lead" action
# (select version 1). That Zap authenticates with the API key issued by
# support@medicareprocrm.com.
MEDICAREPRO_ZAPIER_HOOK_URL=

# Bearer token protecting POST /api/jobs/outbox, which drains the queue.
# EventBridge sends this. Generate with: openssl rand -hex 16
OUTBOX_JOB_TOKEN=

# --- Spam protection --------------------------------------------------------
# Cloudflare Turnstile. With TURNSTILE_SECRET unset, verification is skipped so
# forms remain testable locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Email ------------------------------------------------------------------
# Verified SES sender, e.g. no-reply@yourdomain.com
# Fallback only — set this in the CMS under Site Settings instead.
LEAD_NOTIFICATION_EMAILS=

# Verified SES sender, e.g. no-reply@yourdomain.com
SES_FROM_ADDRESS=

# --- Analytics --------------------------------------------------------------
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Consent Mode v2 defaults
# to denied until the visitor opts in, and a Global Privacy Control signal is
# honoured automatically.
NEXT_PUBLIC_GTM_ID=

# --- Scheduling -------------------------------------------------------------
# Calendly inline embed URL, e.g. https://calendly.com/you/intro-call
NEXT_PUBLIC_CALENDLY_URL=
