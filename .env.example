# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# In AWS none of this comes from a file: Terraform writes the secrets into AWS
# Secrets Manager and the ECS task definition injects them as environment
# variables. See infra/modules/app/main.tf. So this file is for local
# development, and as the checklist of what production needs.
#
# Blank vs unset: several readers go through env() in src/lib/env.ts, which
# treats a blank or whitespace-only value as absent. Leaving a key empty is the
# supported way to say "not configured" — it is not the same as a value of "".
#
# Nothing below is required to boot the site locally. With everything unset you
# get: disk-based media, no CRM delivery, no bot check, no email, no analytics.
# The lead pipeline still works end to end into Postgres.

# --- Core -------------------------------------------------------------------
# Postgres connection string. The database is called legacybenefitsmn
# everywhere — this file, docker-compose.yml, CI and the README. Two ways to get
# one locally:
#
#   pnpm db:up                    -> port 5433, credentials postgres/postgres
#                                    (this repo's docker-compose.yml)
#   brew install postgresql@17    -> port 5432, your macOS username, no password
#     brew services start postgresql@17 && createdb legacybenefitsmn
#
# The compose route only creates the database the FIRST time the volume is
# initialised. If you already have a pgdata volume from an older checkout it
# will keep whatever name it was built with, and `pnpm db:up` will not add the
# new one — `pnpm db:down && docker volume rm nates-website_pgdata` first.
#
# Then apply the schema:  pnpm migrate && pnpm drizzle:migrate
# Creating the database is on you: the app will NOT create one it cannot then
# populate (disableCreateDatabase in src/payload.config.ts). A missing database
# fails with "cannot connect to Postgres: database ... does not exist".
#
# In AWS this is the RDS endpoint, written to Secrets Manager by Terraform.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/legacybenefitsmn

# Signing key for Payload admin sessions and the salt for hashed visitor IPs
# (src/lib/leads/service.ts). Any 32+ character random string.
#   openssl rand -hex 32
# Changing it logs every admin out and makes previously stored IP hashes
# unmatchable. Treat it as permanent once live.
PAYLOAD_SECRET=change-me-32-chars-minimum

# Public origin, used for canonical URLs, sitemap.xml, robots.txt and JSON-LD.
# Only set this for local development. In AWS, Terraform passes it to the
# container from the `domain_name` variable, and when no domain is configured
# the app derives its origin from the request headers instead
# (src/lib/site-url.ts), which is what lets it run on the CloudFront URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: cap the Postgres connection pool (defaults to 10). Raise only if
# you also raise RDS max_connections; ECS runs several tasks, each with a pool.
PGPOOL_MAX=10

# --- Infrastructure ----------------------------------------------------------
# Prefix for every AWS resource name. Terraform reads it natively as TF_VAR_name
# (infra/envs/*/variables.tf declares `name` with no default, so an unset value
# stops the apply rather than silently inheriting one).
#
# Lowercase, hyphens only, under 23 characters. It becomes the S3 media bucket,
# the RDS instance, the ALB, the ECR repository, every IAM role and all five
# Secrets Manager paths — roughly 40 resource names in total.
#
# NOT the same as BUSINESS_NAME below. That is the display name shown to
# visitors and stored verbatim in TCPA consent text ("Legacy Benefits MN"); this
# is a DNS- and ARN-safe identifier that visitors never see.
#
# Changing it after an apply destroys and recreates nearly the whole stack, and
# the old secret names stay reserved for their recovery window, which blocks the
# re-apply. Decide it once, before the first apply.
TF_VAR_name=legacybenefitsmn

# --- Business & owner identity ----------------------------------------------
# Ask the client for these. They are the CMS's initial values, read by the seed
# script (src/scripts/seed.ts), and a fallback before anything is seeded.
#
# After the first seed the CMS at /admin is the source of truth — Site Settings
# is where the client edits their own phone number or address without a
# redeploy. These env vars are only the bootstrap and the emergency fallback
# (src/lib/business.ts resolves CMS -> env -> generic default).
#
# Real names, emails and phone numbers are kept out of git deliberately. Leave
# them unset and the seed produces obviously-fictional placeholder data, which
# is what belongs in a shared repository.
#
# BUSINESS_NAME matters most: it is interpolated into the TCPA consent text
# stored verbatim with every lead as legal evidence. It must be the legal
# entity name the client actually does business as.
BUSINESS_NAME="Example Benefits"
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=

# The practice owner, seeded as the team member on /team.
# For a one-person practice leave OWNER_EMAIL and OWNER_PHONE unset — they fall
# back to BUSINESS_EMAIL and BUSINESS_PHONE.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=

# --- Media ------------------------------------------------------------------
# Leave S3_BUCKET empty locally: Payload falls back to disk storage under
# media/, so no AWS credentials are needed to run the site.
#
# In AWS, Terraform creates the bucket and the ECS task role grants access —
# there are no access keys anywhere in this project. Get the name after apply:
#   cd infra/envs/prod && terraform output media_bucket
S3_BUCKET=
AWS_REGION=us-east-1

# Host for next/image remotePatterns (next.config.ts). Read at BUILD time, not
# runtime, so it only has any effect if passed as a Docker build arg.
#
# Leave it empty. Payload serves uploads from the relative /api/media/file/...,
# which next/image accepts without any remotePatterns entry, so nothing needs
# this today. It exists for the case where media URLs ever become absolute.
# Terraform deliberately does NOT set it — it was previously injected into the
# ECS task definition, where it could never take effect.
NEXT_PUBLIC_MEDIA_HOST=

# --- Lead delivery to MedicarePRO CRM ---------------------------------------
# Transport: "mock" (stores and queues, delivers nowhere) | "webhook" | "zapier"
#
# Leads are always written to Postgres first and queued in crm_outbox, so an
# unset transport delays delivery but never loses a lead — flip this to
# "webhook" later and run the drain to catch up.
#
# Unset or blank means "mock". Any OTHER value is rejected on first use rather
# than falling back, because the mock reports every send as successful: a typo
# here would mark each outbox row `sent`, leave the failure count at zero, and
# discard every live lead with the dashboard reading green.
CRM_TRANSPORT=mock

# Preferred transport. Log in to MedicarePRO -> Settings -> Integrations ->
# Inbound webhook, and generate a URL.
#
# It is displayed exactly ONCE and cannot be retrieved again. Paste it straight
# into a password manager and into Secrets Manager before closing the dialog.
# If it is lost, generate a new one (the old one keeps working) or fall back to
# the Zapier transport below.
MEDICAREPRO_WEBHOOK_URL=

# Fallback transport, for when the webhook URL is unavailable.
# 1. In Zapier create a Zap with a "Webhooks by Zapier -> Catch Hook" trigger.
# 2. Copy the catch-hook URL it generates into this variable.
# 3. Add an action step: the MPCRM app, "Add Lead", version 1.
# 4. Authenticate that step with the API key from support@medicareprocrm.com
#    (email them to request one; it is not self-service).
MEDICAREPRO_ZAPIER_HOOK_URL=

# Bearer token protecting POST /api/jobs/outbox, which drains the queue to the
# CRM. EventBridge sends it on a schedule; nothing else should ever call it.
#   openssl rand -hex 16
# Terraform generates this for the AWS environments — this variable is only for
# calling the endpoint by hand locally. Whitespace is trimmed on read, because
# HTTP strips it from headers in transit and the two sides must agree.
OUTBOX_JOB_TOKEN=

# --- Spam protection --------------------------------------------------------
# Cloudflare Turnstile, the bot check on the contact, SOA and do-not-contact
# forms. Free, no Cloudflare-hosted DNS required.
#
# dash.cloudflare.com -> Turnstile -> Add site. Enter the domain, choose the
# "Managed" widget. You get two values:
#   Site key   -> NEXT_PUBLIC_TURNSTILE_SITE_KEY (public, ships to the browser)
#   Secret key -> TURNSTILE_SECRET               (server only, never public)
#
# Add localhost as an allowed hostname if you want to exercise it locally.
#
# With TURNSTILE_SECRET empty, verification is skipped entirely so forms stay
# testable without Cloudflare. A whitespace-only value throws on first use
# rather than guessing between "skip the check" and "reject everyone" — see
# src/lib/security/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Email ------------------------------------------------------------------
# Where new-lead notifications go. Comma-separated; whitespace is trimmed and
# blank entries dropped.
#
# Fallback only — set this in the CMS under Site Settings -> Lead notification
# emails instead, so the client can change who gets notified without a deploy.
# With no recipients anywhere, sending is skipped and reported rather than
# throwing, and the agency silently never hears about a lead.
LEAD_NOTIFICATION_EMAILS=

# The From: address on outbound mail. Must be an identity you have verified in
# Amazon SES, e.g. no-reply@yourdomain.com.
#
# Terraform's email module verifies the domain and publishes the SES DKIM
# records. A brand-new SES account is in the sandbox and can only send to
# verified addresses — open a support case to request production access before
# go-live, or confirmation emails to real visitors will be rejected.
#
# Credentials come from the ECS task role; there are no SES access keys here.
# Leave empty locally: sends are logged to the console and skipped.
SES_FROM_ADDRESS=

# --- Analytics --------------------------------------------------------------
# Google Tag Manager container ID, e.g. GTM-XXXXXXX.
# tagmanager.google.com -> create an account and a Web container -> the ID is
# shown at the top of the workspace.
#
# Consent Mode v2 defaults to denied until the visitor opts in via the banner,
# and a Global Privacy Control browser signal is honoured automatically with no
# banner shown. Leave empty to load no analytics at all.
NEXT_PUBLIC_GTM_ID=

# --- Scheduling -------------------------------------------------------------
# Calendly inline embed URL, e.g. https://calendly.com/you/intro-call
# calendly.com -> the event type -> Share -> Add to website -> Inline embed;
# use the plain event URL, not the full <script> snippet.
# Leave empty to hide the scheduler section.
NEXT_PUBLIC_CALENDLY_URL=
