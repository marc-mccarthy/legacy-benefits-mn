# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#
# env() in src/lib/env.ts treats blank and whitespace-only as absent, so an
# empty value is how a key says "not configured". Every OPTIONAL key below
# names what happens when it is blank.
#
# With everything except DATABASE_URL blank the site runs: no CRM delivery, no
# bot check, no email, no analytics. The lead pipeline still writes to Postgres.
#
# In AWS these come from the Lambda environment, written by infra/compute.tf,
# and from GitHub Actions variables, written by infra/github.tf.

# --- Database ---------------------------------------------------------------
# REQUIRED. src/lib/db/index.ts passes it straight to the pool.
#   brew services start postgresql@17   -> port 5432
#   docker compose up -d                -> port 5433, postgres/postgres
# Then: pnpm migrate && pnpm drizzle:migrate
DATABASE_URL=

# OPTIONAL. Blank -> 10. Pool size per process (src/lib/db/index.ts).
PGPOOL_MAX=

# --- Site -------------------------------------------------------------------
# OPTIONAL. Blank -> https://example.invalid (src/lib/site-url.ts).
# Origin for sitemap.xml, robots.txt, canonical URLs and JSON-LD. Read at BUILD
# time and baked into the HTML, so a change needs a rebuild.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL. Blank -> IP hashes are unsalted (src/lib/leads/service.ts).
# Changing it makes previously stored ip_hash values unmatchable.
#   openssl rand -hex 32
PAYLOAD_SECRET=

# --- Business identity ------------------------------------------------------
# OPTIONAL. Blank -> the values in src/content/site.ts.
# BUSINESS_NAME is interpolated into the TCPA consent text stored with each lead.
BUSINESS_NAME=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=

# --- Media ------------------------------------------------------------------
# OPTIONAL. Blank -> next/image allows no remote host (next.config.ts), so
# uploaded images are not optimised. The CloudFront host serving /media.
NEXT_PUBLIC_MEDIA_HOST=

# --- Lead delivery ----------------------------------------------------------
# OPTIONAL. Blank -> "mock": leads are stored and queued in crm_outbox but
# delivered nowhere. Any value other than mock | webhook | zapier is rejected on
# first use rather than falling back (src/lib/crm/index.ts).
CRM_TRANSPORT=

# Required by CRM_TRANSPORT="webhook". MedicarePRO -> Settings -> Integrations
# -> Inbound webhook. Shown once and not retrievable afterwards.
MEDICAREPRO_WEBHOOK_URL=

# Required by CRM_TRANSPORT="zapier". A "Webhooks by Zapier -> Catch Hook"
# trigger URL, with an MPCRM "Add Lead" action behind it.
MEDICAREPRO_ZAPIER_HOOK_URL=

# OPTIONAL locally. Bearer token for POST /api/jobs/outbox, which drains the
# queue. Whitespace is trimmed on read. Terraform generates its own in AWS.
#   openssl rand -hex 16
OUTBOX_JOB_TOKEN=

# --- Spam protection --------------------------------------------------------
# Cloudflare Turnstile on the contact, SOA and do-not-contact forms.
# dash.cloudflare.com -> Turnstile -> Add site, widget mode "Managed".
#
# OPTIONAL, both. Blank site key -> the widget renders nothing. Blank secret ->
# verification is skipped (src/lib/security/turnstile.ts).
#
# A non-empty secret is treated as configured, so a placeholder string makes
# verifyTurnstile call Cloudflare with it and every submission answers 403.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Email ------------------------------------------------------------------
# OPTIONAL. Blank -> no notification recipients. Comma-separated; whitespace
# trimmed and blank entries dropped.
LEAD_NOTIFICATION_EMAILS=

# OPTIONAL. Blank -> sends are logged and skipped (src/lib/email/index.ts).
# An identity verified in Amazon SES. A new SES account is sandboxed and can
# only send to verified addresses until production access is granted.
SES_FROM_ADDRESS=

# OPTIONAL. Blank -> us-east-1. Region for the SES client.
AWS_REGION=

# --- Analytics and scheduling -----------------------------------------------
# OPTIONAL. Blank -> no analytics loads. Google Tag Manager container, GTM-XXXXXXX.
# Consent Mode v2 denies by default until the banner is accepted, and a Global
# Privacy Control signal is honoured without showing one.
NEXT_PUBLIC_GTM_ID=

# OPTIONAL. Blank -> the scheduler section is hidden. The plain Calendly event
# URL, e.g. https://calendly.com/you/intro-call — not the <script> snippet.
NEXT_PUBLIC_CALENDLY_URL=
