# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
#   cd infra/envs/dev
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init && terraform plan
#
# Dev is intended to run WITHOUT a custom domain: it is served over HTTPS on
# the CloudFront URL that `terraform output site_url` prints after apply. That
# avoids certificates, DNS records, and any chance of colliding with the
# production zone.
#
# Only give dev a hostname if you genuinely need one, and if you do, delegate a
# subdomain from the production zone rather than creating a second zone for the
# same domain — two zones for one domain break resolution in ways that are hard
# to diagnose.
#
# Anything not set here falls back to the default in variables.tf: region
# (us-east-1), vpc_cidr, name. Dev also declares the same DNS variables as prod
# (dns_records, google_workspace_mx, spf_record, dkim_records, dmarc_record) so
# the two environments stay identical, but none of them do anything while
# use_domain is false and create_dns_zone is false — the dns module is not
# instantiated at all.

# --- DNS: deliberately off --------------------------------------------------
# use_domain is the switch: false serves dev on the CloudFront URL with
# CloudFront's own certificate, so there is no ACM certificate, no Route 53
# record and no SES identity to go wrong.
#
# Leave the values below empty rather than copying prod's here dormant.
# Carrying prod's domain_name and record set in this file would put dev one
# boolean away from creating a SECOND Route 53 zone for a domain that carries
# live mail, and two zones for one domain break resolution in ways that are
# hard to diagnose from the symptoms.
use_domain      = false
domain_name     = ""
hosted_zone_id  = ""
create_dns_zone = false

# --- Identity ---------------------------------------------------------------
# Keep dev's identity obviously fake. It is interpolated into the TCPA consent
# text stored with every lead, and dev leads are test data — a real business
# name here produces consent records that look genuine but are not.
business_name  = "Example Benefits"
business_phone = "(555) 555-0142"

# --- Deployment -------------------------------------------------------------
# owner/repo allowed to assume the deploy role via GitHub OIDC. Same repository
# as prod; the two environments have separate roles and separate state.
github_repository = "your-org/your-repo"

# Where CloudWatch alarms go. Each address gets an SNS subscription-confirmation
# email that must be clicked before it will ever receive an alarm. Worth wiring
# up even in dev — this is where you find out the alarms work.
alert_emails = ["alerts@example.com"]

# Placeholder for the first apply, because ECS will not create a service
# without a resolvable image and ECR is empty until CI has pushed once. CI
# replaces this on every deploy; leave it alone after bootstrap.
image = "public.ecr.aws/nginx/nginx:latest"

# --- Not set here, and why --------------------------------------------------
# crm_transport defaults to "mock" in BOTH environments now. prod used to
# default to "webhook" against a REPLACE_ME URL, which retried every lead
# forever and pinned the outbox_failures alarm from the first submission. Leave
# dev on mock regardless: pointing it at the real MedicarePRO webhook would push
# test leads into the client's live CRM.
#
# db_instance_class is a prod-only variable; dev sizes its database in main.tf.

