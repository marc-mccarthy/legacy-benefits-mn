# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored, because
# it holds the DKIM public key and other client-specific DNS values.

business_name     = "Example Benefits"
business_phone    = "(555) 555-0142"
github_repository = "your-org/your-repo"
alert_emails      = ["alerts@example.com"]

# Placeholder for the first apply; CI replaces it with a real image afterwards.
image = "public.ecr.aws/nginx/nginx:latest"

# --- DNS --------------------------------------------------------------------
# Leave domain_name empty to be served on the CloudFront URL instead.
domain_name = "example.com"

# true  = create the Route 53 zone here, for migrating DNS in from another host
# false = use an existing zone, set hosted_zone_id below
create_dns_zone = true
# hosted_zone_id = "Z000000000000000000000"

# Copy these from the CURRENT DNS host before switching nameservers. Read them
# off live DNS rather than from memory:
#
#   dig +short MX example.com
#   dig +short TXT example.com
#   dig +short TXT google._domainkey.example.com
#   dig +short TXT _dmarc.example.com
#   dig +short A example.com
#   dig +short CAA example.com
#
# Google Workspace publishes MX in two shapes. Check which one is live —
# applying the wrong one reroutes mail.
#   legacy  = five records, aspmx.l.google.com + alt1-4
#   current = one record,   1 SMTP.GOOGLE.COM
google_workspace_mx        = true
google_workspace_mx_legacy = true

# A domain may publish only ONE SPF record; a second is itself a failure.
spf_record = "v=spf1 include:_spf.google.com ~all"

# Full DKIM value including the "v=DKIM1; k=rsa; p=" prefix. It is split into
# 255-character strings automatically — do not pre-chunk it.
dkim_records = {
  google = "v=DKIM1; k=rsa; p=REPLACE_WITH_FULL_KEY"
}

# p=none is monitoring only: it changes nothing about delivery, and the reports
# show whether SPF and DKIM actually pass before considering enforcement.
dmarc_record = "v=DMARC1; p=none; rua=mailto:dmarc@example.com; fo=1"

# Everything else the domain answers for today. Apex and www A/AAAA records are
# ignored here — the edge module owns those and points them at CloudFront.
dns_records = [
  # { name = "shop", type = "CNAME", records = ["shops.example.net"] },
]
