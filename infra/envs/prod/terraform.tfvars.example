# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars.
# Optional. Leave both empty to be served on the CloudFront URL that
# `terraform output site_url` prints after apply.
#
# hosted_zone_id must be a Route 53 zone. If DNS is hosted elsewhere (Google,
# Squarespace, GoDaddy), create the zone in Route 53 first and repoint the
# registrar's nameservers at it — Terraform then handles certificate
# validation and records automatically.
domain_name    = "legacybenefitsmn.com"
hosted_zone_id = "Z000000000000000000000"
image             = "public.ecr.aws/nginx/nginx:latest" # placeholder for first apply
business_name     = "Legacy Benefits MN"
business_phone    = "(555) 555-0142"
github_repository = "marc-mccarthy/legacy-benefits-mn"
alert_emails      = ["alerts@legacybenefitsmn.com"]
