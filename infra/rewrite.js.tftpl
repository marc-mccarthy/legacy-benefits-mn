function handler(event) {%{ if basic_auth != "" }
  var auth = event.request.headers.authorization;
  if (!auth || auth.value !== "Basic ${basic_auth}") {
    return { statusCode: 401, statusDescription: "Unauthorized",
      headers: { "www-authenticate": { value: 'Basic realm="dev"' } } };
  }%{ endif }
  var host = event.request.headers.host.value;
  if (host.indexOf("www.") === 0) {
    var qs = event.request.querystring;
    var q = Object.keys(qs).map(function (k) {
      return qs[k].value ? k + "=" + qs[k].value : k;
    }).join("&");
    return {
      statusCode: 301,
      statusDescription: "Moved Permanently",
      headers: {
        location: {
          value: "https://" + host.slice(4) + event.request.uri + (q ? "?" + q : ""),
        },
      },
    };
  }

  var uri = event.request.uri;

  if (uri !== "/" && uri.endsWith("/")) {
    uri = uri.slice(0, -1);
  }
  if (uri === "/") {
    uri = "/index.html";
  } else if (!uri.includes(".")) {
    uri = uri + ".html";
  }
  event.request.uri = uri;
  return event.request;
}
