{
  "name": "legacy-benefits-mn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/with-env.sh next dev",
    "build": "sh scripts/with-env.sh next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "sh scripts/with-env.sh vitest run",
    "test:unit": "vitest run --project 'unit*'",
    "test:integration": "sh scripts/with-env.sh vitest run --project integration",
    "test:coverage": "vitest run --project 'unit*' --coverage",
    "test:watch": "vitest --project 'unit*'",
    "test:e2e": "sh scripts/with-env.sh playwright test",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "sh scripts/with-env.sh drizzle-kit migrate",
    "db:status": "pg_isready",
    "db:create": "createdb legacybenefitsmn",
    "db:drop": "dropdb --if-exists legacybenefitsmn",
    "db:psql": "psql -d legacybenefitsmn",
    "db:reset": "pnpm db:drop && pnpm db:create && pnpm drizzle:migrate",
    "db:server:init": "initdb -D .pgdata",
    "db:server:start": "pg_ctl -D .pgdata -l .pgdata/server.log start",
    "db:server:stop": "pg_ctl -D .pgdata stop",
    "diagrams:derive": "node scripts/generate-derived-diagrams.mjs",
    "diagrams:build": "node scripts/generate-derived-diagrams.mjs && node scripts/generate-diagrams.mjs",
    "diagrams:check": "node scripts/generate-derived-diagrams.mjs --check && node scripts/generate-diagrams.mjs --check",
    "reference:capture": "node scripts/capture-reference-site.mjs",
    "reference:check": "node scripts/capture-reference-site.mjs --check",
    "docs:check": "node scripts/check-doc-references.mjs && node scripts/generate-doc-sections.mjs --check",
    "docs:generate": "node scripts/generate-doc-sections.mjs",
    "docs:sync": "bash scripts/docs-sync.sh",
    "check": "lefthook run verify-all",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1127.0",
    "@hookform/resolvers": "5.9.1",
    "@next/third-parties": "16.3.4",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "lenis": "1.3.26",
    "lucide-react": "1.42.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "three": "0.186.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "lefthook": "2.1.14",
    "mermaid": "12.0.0",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
